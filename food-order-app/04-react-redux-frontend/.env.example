# Copy to .env (or .env.local) and restart `npm start`. Create React App reads
# these at start/build time, so only variables starting with REACT_APP_ work.

# Base URL of the backend API, including the version prefix. The API must allow
# CORS from this app's origin (http://localhost:3000 in development).
#
#   05-node-http-api         http://localhost:8080/v1/       (default)
#   06-express-mongodb-api   http://localhost:8080/api/v1/
REACT_APP_API_BASE_URL=http://localhost:8080/v1/

# Login endpoint, relative to the base URL.
#   login         05-node-http-api         POST /v1/login
#   users/login   06-express-mongodb-api   POST /api/v1/users/login
REACT_APP_LOGIN_PATH=login
