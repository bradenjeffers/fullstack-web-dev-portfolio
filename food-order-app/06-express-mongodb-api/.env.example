# Copy to .env and adjust. Never commit the real .env file.

# Required (the server refuses to start without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=

# MongoDB connection string for development. Default if unset: mongodb://127.0.0.1:27017/food_order_app
# (required when NODE_ENV=production)
DATABASE_URI=mongodb://127.0.0.1:27017/food_order_app

# Used only by `npm test`. The database name must end in _test because the tests empty its collections.
TEST_DATABASE_URI=mongodb://127.0.0.1:27017/food_order_app_test

PORT=8080

# How long a login token stays valid (any jsonwebtoken "expiresIn" value).
JWT_EXPIRES_IN=7d

# Development convenience only. When "true", POST /api/v1/users honours isAdmin: true so you can
# create an admin through the API. Leave it false and use `npm run create-admin` instead.
ALLOW_ADMIN_SIGNUP=false

# Used by `npm run create-admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULLNAME=Administrator
